# Set environment variables in your shell. No key is required for deterministic mode.
RISA_DB=data/risa.db
AI_PROVIDER=deterministic
# Optional: openai_compatible (any compatible provider endpoint)
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=
AI_API_KEY=
# Optional: gemini. Choose an available model in Google AI Studio.
GEMINI_API_KEY=
GEMINI_MODEL=
